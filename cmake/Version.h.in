#pragma once

// The version of qcodeedit a program (or plugin) is built with (these
// macros), and the version of the libraries it runs with (libraryVersion():
// shared libraries can be other ones). Generated by CMake from
// cmake/Version.h.in.
//
// QCE_ABI_VERSION changes whenever the binary interface does: a field of a
// plain struct (TextCursor, ExtraSelection, ...), a virtual function of an
// interface (IHighlighter, IMargin, ...), a signature. The classes keep
// their fields in a private part (pimpl), so adding one does not change it.
// It is the shared libraries' SONAME (libqcodeedit.so.<ABI>, the same for
// every part), so the system loads no other one. Within one ABI a newer
// library only adds things, and code built for an older one keeps working.

#define QCE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define QCE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define QCE_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define QCE_VERSION_STRING "@PROJECT_VERSION@"
#define QCE_ABI_VERSION @QCE_ABI_VERSION@

namespace qce {

struct LibraryVersion {
    int abi;
    int major;
    int minor;
    int patch;
};

// The version of the qcodeedit libraries running (built into them).
LibraryVersion libraryVersion();

// Whether the running libraries fit the headers this code was built with:
// the same ABI, and the same version or a newer one (it may have more).
inline bool libraryFits()
{
    const LibraryVersion v = libraryVersion();
    if (v.abi != QCE_ABI_VERSION)
        return false;
    if (v.major != QCE_VERSION_MAJOR)
        return v.major > QCE_VERSION_MAJOR;
    if (v.minor != QCE_VERSION_MINOR)
        return v.minor > QCE_VERSION_MINOR;
    return v.patch >= QCE_VERSION_PATCH;
}

} // namespace qce
