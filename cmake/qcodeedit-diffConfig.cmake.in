@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 COMPONENTS Widgets)
find_dependency(qcodeedit @PROJECT_VERSION@ REQUIRED)
# Built with an installed DiffMerge's libdiffcore, or with its sources inside.
if(@QCE_DIFF_USES_DIFFMERGE@)
    find_dependency(DiffMerge 1.6 CONFIG COMPONENTS Core)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/qcodeedit-diffTargets.cmake")

check_required_components(qcodeedit-diff)
